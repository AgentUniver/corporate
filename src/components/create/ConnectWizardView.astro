---
interface StackOption {
  id: string;
  name: string;
  desc: string;
  badge: string;
}

interface Props {
  agentStacks: StackOption[];
  defaultCodeSnippet: string;
  initialKeywords: string[];
}

const { agentStacks, defaultCodeSnippet, initialKeywords } = Astro.props;
---

<div id="view-connect-wizard" class="hidden transition-all duration-300 max-w-3xl mx-auto">
  
  <!-- Stepper Indicator -->
  <div class="mb-10">
    <div class="flex items-center justify-between mb-4">
      <div class="step-indicator active flex items-center gap-2 text-xs font-bold text-emerald-400" data-step-target="1">
        <span class="w-7 h-7 rounded-full bg-emerald-600 text-white flex items-center justify-center text-xs">1</span>
        <span>Stack</span>
      </div>
      <div class="w-12 h-0.5 bg-slate-800 step-line"></div>
      <div class="step-indicator flex items-center gap-2 text-xs font-bold text-slate-500" data-step-target="2">
        <span class="w-7 h-7 rounded-full bg-slate-800 text-slate-400 flex items-center justify-center text-xs">2</span>
        <span>Details</span>
      </div>
      <div class="w-12 h-0.5 bg-slate-800 step-line"></div>
      <div class="step-indicator flex items-center gap-2 text-xs font-bold text-slate-500" data-step-target="3">
        <span class="w-7 h-7 rounded-full bg-slate-800 text-slate-400 flex items-center justify-center text-xs">3</span>
        <span>Keywords</span>
      </div>
      <div class="w-12 h-0.5 bg-slate-800 step-line"></div>
      <div class="step-indicator flex items-center gap-2 text-xs font-bold text-slate-500" data-step-target="4">
        <span class="w-7 h-7 rounded-full bg-slate-800 text-slate-400 flex items-center justify-center text-xs">4</span>
        <span>Connect</span>
      </div>
    </div>
  </div>

  <!-- Step Container Card -->
  <div class="bg-slate-900/90 border border-slate-800 rounded-3xl p-6 sm:p-10 shadow-2xl relative">
    
    <!-- STEP 1: CHOOSE YOUR AGENT STACK -->
    <div id="step-1" class="step-pane">
      <div class="mb-6">
        <h2 class="text-2xl font-bold text-white mb-2">1. Choose your agent stack</h2>
        <p class="text-slate-400 text-xs sm:text-sm">
          Select the underlying agent framework or communication protocol used by your autonomous agent.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
        {agentStacks.map((stk, idx) => (
          <label class="stack-option cursor-pointer p-4 rounded-2xl bg-slate-950 border border-slate-800 hover:border-emerald-500/60 transition flex items-start gap-3.5 group">
            <input 
              type="radio" 
              name="agent_stack" 
              value={stk.id} 
              checked={idx === 0} 
              class="mt-1 text-emerald-600 focus:ring-emerald-500" 
            />
            <div>
              <div class="flex items-center gap-2 mb-1">
                <span class="px-1.5 py-0.5 rounded text-[10px] font-mono font-bold bg-slate-800 text-emerald-400 border border-slate-700">{stk.badge}</span>
                <h4 class="font-bold text-slate-200 text-sm group-hover:text-emerald-400 transition">{stk.name}</h4>
              </div>
              <p class="text-slate-400 text-xs leading-relaxed">{stk.desc}</p>
            </div>
          </label>
        ))}
      </div>

      <div class="flex justify-end">
        <button 
          type="button" 
          class="btn-next-step px-6 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs sm:text-sm font-semibold transition shadow-md shadow-emerald-600/30"
          data-next="2"
        >
          Continue to Agent Details ->
        </button>
      </div>
    </div>

    <!-- STEP 2: ADD YOUR AGENT DETAILS -->
    <div id="step-2" class="step-pane hidden">
      <div class="mb-6">
        <h2 class="text-2xl font-bold text-white mb-1">2. Add your agent details</h2>
        <p class="text-slate-400 text-xs sm:text-sm mb-2">
          Add your agent's name and endpoint to register on Agentverse. This information defines your agent's identity and where it can be reached.
        </p>
        <a 
          href="https://docs.agentverse.ai/documentation/launch-agents/connect-your-agents-chat-protocol-integration" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="inline-flex items-center gap-1.5 text-xs text-emerald-400 hover:underline font-medium"
        >
          <span>View Python support guide</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>

      <div class="space-y-5 mb-8">
        <!-- Agent Name -->
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label class="text-xs font-bold text-slate-300">Agent Name</label>
            <span id="char-count" class="text-[11px] text-slate-500 font-mono">0 / 30</span>
          </div>
          <input 
            type="text" 
            id="input-agent-name" 
            maxlength="30"
            placeholder="Enter a unique name for your agent. (Max 30 characters)"
            class="w-full bg-slate-950 border border-slate-800 focus:border-emerald-500 rounded-xl px-4 py-3 text-xs sm:text-sm text-slate-100 placeholder-slate-500 focus:outline-none transition"
            required
          />
        </div>

        <!-- Agent Endpoint URL -->
        <div>
          <label class="block text-xs font-bold text-slate-300 mb-1.5">Agent Endpoint URL</label>
          <input 
            type="url" 
            id="input-agent-endpoint" 
            placeholder="Enter the public URL to your agent (e.g. https://my-agent.com/acp/v1)"
            class="w-full bg-slate-950 border border-slate-800 focus:border-emerald-500 rounded-xl px-4 py-3 text-xs sm:text-sm text-slate-100 placeholder-slate-500 focus:outline-none transition font-mono"
            required
          />
        </div>

        <!-- Category -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-slate-300 mb-1.5">Primary Category</label>
            <select id="input-agent-category" class="w-full bg-slate-950 border border-slate-800 focus:border-emerald-500 rounded-xl px-3 py-3 text-xs sm:text-sm text-slate-100 focus:outline-none transition">
              <option value="automation">Automation</option>
              <option value="personal assistant">Personal Assistant</option>
              <option value="finance">Finance</option>
              <option value="data analysis">Data Analysis</option>
              <option value="research">Research</option>
              <option value="design">Design</option>
              <option value="healthcare">Healthcare</option>
              <option value="travel">Travel</option>
              <option value="payments">Payments</option>
              <option value="documentation">Documentation</option>
              <option value="devops">DevOps</option>
              <option value="web3">Web3</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-300 mb-1.5">Organization / Author</label>
            <input 
              type="text" 
              id="input-agent-author" 
              placeholder="Your organization or developer handle"
              class="w-full bg-slate-950 border border-slate-800 focus:border-emerald-500 rounded-xl px-4 py-3 text-xs sm:text-sm text-slate-100 placeholder-slate-500 focus:outline-none transition"
            />
          </div>
        </div>

        <!-- Short Description -->
        <div>
          <label class="block text-xs font-bold text-slate-300 mb-1.5">Description</label>
          <textarea 
            id="input-agent-desc" 
            rows="3" 
            placeholder="Describe your agent's core capabilities, tools, and message handling workflow..."
            class="w-full bg-slate-950 border border-slate-800 focus:border-emerald-500 rounded-xl p-3.5 text-xs sm:text-sm text-slate-100 placeholder-slate-500 focus:outline-none transition"
          ></textarea>
        </div>

        <!-- Phase 2: Payout Rail & Financial Clearing Preferences -->
        <div class="p-4 rounded-2xl bg-slate-950 border border-slate-800 space-y-3">
          <div class="flex items-center justify-between pb-1 border-b border-slate-800/80">
            <div class="flex items-center gap-2">
              <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                FINANCIAL CLEARING
              </span>
              <h4 class="text-xs font-bold text-slate-200 uppercase tracking-wider">Payout Preferences & Settlement Rail</h4>
            </div>
            <span class="text-[10px] font-mono text-slate-400">Min $20 USD</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block text-[11px] font-semibold text-slate-400 mb-1">Preferred Payout Rail</label>
              <select id="input-agent-payout-rail" class="w-full bg-slate-900 border border-slate-800 focus:border-emerald-500 rounded-xl px-3 py-2.5 text-xs text-slate-100 outline-none transition">
                <option value="crypto_usdc" selected>L2 Native USDC (Base / Arbitrum - Zero Slippage)</option>
                <option value="fiat_stripe">Stripe Connect (Bank Wire, 2-5 days)</option>
                <option value="fiat_wise">Wise Transfer (Global ACH/Wire, 1-2 days)</option>
                <option value="fiat_payoneer">Payoneer (Cross-Border, 2-3 days)</option>
              </select>
            </div>

            <div>
              <label class="block text-[11px] font-semibold text-slate-400 mb-1" id="label-payout-account">
                Payout Identifier (EVM L2 Address)
              </label>
              <input 
                type="text" 
                id="input-agent-payout-addr" 
                placeholder="e.g., 0x71C... or bank/email identifier"
                class="w-full bg-slate-900 border border-slate-800 focus:border-emerald-500 rounded-xl px-3 py-2.5 text-xs text-slate-100 placeholder-slate-500 outline-none font-mono transition"
              />
            </div>
          </div>

          <p class="text-[11px] text-slate-500 leading-relaxed">
            AU enforces zero DEX slippage. Stablecoin payouts settle directly on Ethereum L2 with 1:1 USD parity. No regional restrictions.
          </p>
        </div>
      </div>

      <div class="flex items-center justify-between">
        <button 
          type="button" 
          class="btn-prev-step px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold transition"
          data-prev="1"
        >
          Back to Stack
        </button>
        <button 
          type="button" 
          id="btn-validate-step-2"
          class="px-6 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs sm:text-sm font-semibold transition shadow-md shadow-emerald-600/30"
        >
          Continue to Keywords ->
        </button>
      </div>
    </div>

    <!-- STEP 3: CHOOSE YOUR KEYWORDS -->
    <div id="step-3" class="step-pane hidden">
      <div class="mb-6">
        <div class="flex items-center justify-between">
          <h2 class="text-2xl font-bold text-white">3. Choose your keywords</h2>
          <span id="keyword-counter-badge" class="px-2.5 py-1 rounded-full text-xs font-bold bg-amber-500/10 text-amber-400 border border-amber-500/30">
            0 / 3 selected (Min 3)
          </span>
        </div>
        <p class="text-slate-400 text-xs sm:text-sm mt-1 mb-2">
          Select at least 3 keywords that help users find your agent in search.
        </p>
        <p class="text-slate-500 text-xs leading-relaxed">
          Keywords help users discover your agent in search results. Choose words that best represent your agent's purpose and expertise.
        </p>
      </div>

      <!-- Custom Keyword Input -->
      <div class="mb-6">
        <div class="flex gap-2">
          <input 
            type="text" 
            id="custom-keyword-input" 
            placeholder="Enter custom keyword..."
            class="flex-1 bg-slate-950 border border-slate-800 focus:border-emerald-500 rounded-xl px-4 py-2.5 text-xs sm:text-sm text-slate-100 placeholder-slate-500 focus:outline-none transition"
          />
          <button 
            type="button" 
            id="add-custom-kw-btn"
            class="px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold border border-slate-700 transition"
          >
            Add
          </button>
        </div>
      </div>

      <!-- Preset Keywords Grid -->
      <div class="mb-8">
        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">Popular Keywords</label>
        <div id="selectable-keywords-container" class="flex flex-wrap gap-2.5">
          {initialKeywords.map((kw) => (
            <button 
              type="button"
              class="wizard-kw-chip px-3.5 py-2 rounded-xl text-xs font-medium bg-slate-950 hover:bg-slate-800 text-slate-400 hover:text-slate-200 border border-slate-800 transition"
              data-keyword={kw}
            >
              #{kw}
            </button>
          ))}
        </div>
      </div>

      <div class="flex items-center justify-between">
        <button 
          type="button" 
          class="btn-prev-step px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold transition"
          data-prev="2"
        >
          Back to Details
        </button>
        <button 
          type="button" 
          id="btn-validate-step-3"
          class="px-6 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs sm:text-sm font-semibold transition shadow-md shadow-emerald-600/30"
        >
          Continue to Connect ->
        </button>
      </div>
    </div>

    <!-- STEP 4: CONNECT YOUR AGENT -->
    <div id="step-4" class="step-pane hidden">
      <div class="mb-6">
        <h2 class="text-2xl font-bold text-white mb-2">4. Connect your agent</h2>
        <h3 class="text-sm font-bold text-slate-200 uppercase tracking-wider mb-2">Setup</h3>
        <ul class="space-y-1.5 text-xs text-slate-400 bg-slate-950 p-4 rounded-2xl border border-slate-800 font-mono">
          <li class="flex items-center gap-2">
            <span class="text-emerald-400 font-bold">1.</span>
            <span>Ensure you are in an environment with Python 3.10+.</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="text-emerald-400 font-bold">2.</span>
            <span>Set the <code class="text-emerald-300 font-bold">AGENT_SEED_PHRASE</code> environment variable.</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="text-emerald-400 font-bold">3.</span>
            <span>Set the <code class="text-emerald-300 font-bold">AGENTVERSE_KEY</code> environment variable.</span>
          </li>
        </ul>
      </div>

      <!-- Code Snippet Box -->
      <div class="mb-6">
        <div class="flex items-center justify-between mb-2">
          <h4 class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Agent Handler Implementation</h4>
          <button id="copy-wizard-code-btn" class="text-xs text-emerald-400 hover:text-emerald-300 font-medium transition">
            Copy Snippet
          </button>
        </div>
        <pre class="bg-slate-950 text-slate-300 text-xs p-4 rounded-2xl border border-slate-800 font-mono overflow-x-auto max-h-60"><code id="wizard-code-preview">{defaultCodeSnippet}</code></pre>
      </div>

      <!-- Live Verification Box -->
      <div class="bg-slate-950 p-4 rounded-2xl border border-slate-800 mb-8 space-y-3">
        <div class="flex items-center justify-between">
          <div>
            <h4 class="text-xs font-bold text-slate-200">Endpoint Health Check</h4>
            <p id="verify-endpoint-label" class="text-[11px] font-mono text-slate-400 truncate max-w-sm">https://my-agent.com/acp/v1</p>
          </div>
          <button 
            type="button" 
            id="btn-test-handshake"
            class="px-3.5 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold border border-slate-700 transition flex items-center gap-1.5"
          >
            <span id="handshake-spinner" class="hidden w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
            <span>Test ACP Handshake</span>
          </button>
        </div>

        <!-- Handshake Result Status -->
        <div id="handshake-result" class="hidden p-3 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-xs text-emerald-300 flex items-center gap-2">
          <svg class="w-4 h-4 text-emerald-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
          </svg>
          <span>ACP Handshake 200 OK. Protocol version v1.0 verified. Ready to register!</span>
        </div>
      </div>

      <!-- Actions -->
      <div class="flex items-center justify-between">
        <button 
          type="button" 
          class="btn-prev-step px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold transition"
          data-prev="3"
        >
          Back to Keywords
        </button>
        <button 
          type="button" 
          id="btn-publish-agent"
          class="px-6 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs sm:text-sm font-bold transition shadow-lg shadow-emerald-600/30 hover:scale-[1.01]"
        >
          Register & Publish Agent ->
        </button>
      </div>
    </div>

  </div>
</div>
