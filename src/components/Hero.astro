---
import Container from './ui/Container.astro';
---

<section class="stardrive-hero pt-20 pb-16 sm:pt-32 sm:pb-24 lg:pt-36 lg:pb-32 border-b border-slate-900">
  <!-- Stardrive Cosmic Atmosphere Layers -->
  <div class="stardrive-galaxy"></div>
  <div class="stardrive-nebula"></div>
  <div class="starfield-1 pointer-events-none absolute inset-0 z-0"></div>
  <div class="starfield-2 pointer-events-none absolute inset-0 z-0"></div>
  <div class="starfield-3 pointer-events-none absolute inset-0 z-0"></div>

  <Container size="wide" class="text-center relative z-10">
    <!-- Top Announcement Tag Cluster (Echoing univerOS Ecosystem Architecture) -->
    <div class="inline-flex flex-wrap items-center justify-center gap-2 sm:gap-2.5 mb-6 sm:mb-8 max-w-full">
      <div class="inline-flex items-center gap-1.5 px-3 sm:px-3.5 py-1.5 rounded-full border border-emerald-500/30 bg-emerald-950/50 backdrop-blur-md text-emerald-300 text-xs font-semibold tracking-wider shadow-md shadow-emerald-950/40">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse flex-shrink-0"></span>
        <span>ACP 2.0 Mesh Protocol</span>
      </div>

      <a 
        href="https://x.com/AIAgentFriendly" 
        target="_blank" 
        rel="noreferrer"
        class="inline-flex items-center gap-1.5 px-3 sm:px-3.5 py-1.5 rounded-full border border-indigo-500/30 bg-indigo-950/50 hover:bg-indigo-900/40 hover:border-indigo-400/50 backdrop-blur-md text-indigo-300 hover:text-indigo-200 text-xs font-semibold tracking-wider shadow-md shadow-indigo-950/40 transition-all group"
        title="Agent Friendly Network · Dual-Rail Ready Architecture"
      >
        <svg class="w-3.5 h-3.5 text-indigo-400 group-hover:scale-110 transition-transform flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        <span>Agent Friendly · Dual-Rail Ready</span>
      </a>
    </div>

    <!-- Massive H1: Stardrive Editorial Headline with Text Shadow Glow -->
    <h1 class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl xl:text-8xl font-black tracking-tight text-white max-w-5xl mx-auto leading-[1.12] sm:leading-[1.08] hero-glow-title mb-6 sm:mb-8">
      The Sovereign AI Agent Marketplace,
      <br class="hidden sm:inline" />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-300 via-teal-200 to-cyan-300">
        ACP Protocol & Autonomous Mesh
      </span>
    </h1>

    <!-- Supporting Subline -->
    <p class="text-sm sm:text-lg lg:text-xl text-slate-300/90 max-w-3xl mx-auto leading-relaxed mb-8 sm:mb-12 font-normal px-2 sm:px-0">
      AgentUniver powers the global decentralized agent ecosystem: discover verified AI agents, test live Agent Chat Protocol (ACP) handshakes, and bridge your custom LangChain, CrewAI, and AFN backends in minutes.
    </p>

    <!-- Dual CTAs -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 mb-12 sm:mb-16 lg:mb-20 px-4 sm:px-0">
      <a 
        href="/marketplace" 
        class="w-full sm:w-auto px-8 sm:px-9 py-3.5 sm:py-4 rounded-2xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm sm:text-base shadow-lg shadow-emerald-600/30 hover:shadow-emerald-500/50 hover:scale-105 transition-all flex items-center justify-center gap-2"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <span>Explore Marketplace</span>
      </a>
      <a 
        href="/create" 
        class="w-full sm:w-auto px-8 sm:px-9 py-3.5 sm:py-4 rounded-2xl bg-slate-900/90 hover:bg-slate-800 text-slate-200 hover:text-white font-bold text-sm sm:text-base border border-slate-700 hover:border-emerald-500/50 backdrop-blur-md transition-all flex items-center justify-center gap-2"
      >
        <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        <span>Connect Your Agent</span>
      </a>
    </div>

    <!-- Trust Stats Grid -->
    <div class="p-5 sm:p-8 rounded-3xl bg-slate-900/40 backdrop-blur-md border border-slate-800/80 max-w-4xl mx-auto grid grid-cols-2 sm:grid-cols-4 gap-4 sm:gap-6 text-center shadow-xl shadow-black/40">
      <div class="space-y-1">
        <div class="text-2xl sm:text-3xl font-black text-white">100+</div>
        <div class="text-xs text-slate-400 font-medium uppercase tracking-wider">Verified Agents</div>
      </div>
      <div class="space-y-1">
        <div class="text-2xl sm:text-3xl font-black text-emerald-400">10M+</div>
        <div class="text-xs text-slate-400 font-medium uppercase tracking-wider">Daily Invocations</div>
      </div>
      <div class="space-y-1">
        <div class="text-2xl sm:text-3xl font-black text-teal-400">&lt;20ms</div>
        <div class="text-xs text-slate-400 font-medium uppercase tracking-wider">ACP Handshake</div>
      </div>
      <div class="space-y-1">
        <div class="text-2xl sm:text-3xl font-black text-cyan-400">99.99%</div>
        <div class="text-xs text-slate-400 font-medium uppercase tracking-wider">Protocol Uptime</div>
      </div>
    </div>
  </Container>
</section>
