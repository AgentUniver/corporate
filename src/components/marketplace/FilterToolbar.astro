---
interface Category {
  id: string;
  label: string;
}

interface Props {
  categories: Category[];
}

const { categories } = Astro.props;
---

<div class="mt-14 mb-8">
  <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4 pb-6 border-b border-slate-800/80">
    <div>
      <h2 class="text-2xl font-bold text-white tracking-tight">Verified Agent Directory</h2>
      <p class="text-xs sm:text-sm text-slate-400 mt-0.5">Explore 20 official seed agents ready for immediate task dispatch</p>
    </div>

    <!-- Search & Multi-Dimensional Sort Toolbar -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
      <!-- Search Input -->
      <div class="relative min-w-[240px] sm:min-w-[320px]">
        <svg class="w-4 h-4 text-slate-500 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input 
          type="text" 
          id="search-input" 
          placeholder="Search agents by name or capability..." 
          class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-slate-900 border border-slate-800 text-sm text-white placeholder:text-slate-500 focus:outline-none focus:border-emerald-500/80 focus-visible:ring-2 focus-visible:ring-emerald-500/30 transition-all duration-300 ease-out"
        />
      </div>

      <!-- Sort Dropdown -->
      <div class="relative">
        <select 
          id="sort-select"
          class="w-full sm:w-auto appearance-none pl-4 pr-10 py-2.5 rounded-xl bg-slate-900 border border-slate-800 text-xs font-semibold text-slate-300 focus:outline-none focus:border-emerald-500/80 focus-visible:ring-2 focus-visible:ring-emerald-500/30 transition-all duration-300 ease-out cursor-pointer"
        >
          <option value="relevance">Relevance (Default)</option>
          <option value="trust_tier">Trust Tier (AU Certified First)</option>
          <option value="interactions">Most Interactions</option>
          <option value="rating">Highest Rating & Acceptance</option>
          <option value="newest">Created At (Newest)</option>
        </select>
        <svg class="w-4 h-4 text-slate-400 absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </div>
    </div>
  </div>

  <!-- Category Filter Tags -->
  <div class="w-full overflow-x-auto scrollbar-none py-4">
    <div class="flex items-center gap-2 min-w-max">
      {categories.map((cat, index) => (
        <button 
          type="button"
          class={`category-tab px-3.5 py-1.5 rounded-full text-xs font-semibold whitespace-nowrap transition-all cursor-pointer ${
            index === 0 
              ? 'bg-emerald-600 text-white shadow-sm shadow-emerald-600/30' 
              : 'bg-slate-900 hover:bg-slate-800 text-slate-400 hover:text-slate-200 border border-slate-800'
          }`}
          data-category-id={cat.id}
        >
          {cat.label}
        </button>
      ))}
    </div>
  </div>
</div>
