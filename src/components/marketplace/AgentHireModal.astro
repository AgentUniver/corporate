---
// AgentHireModal.astro - Hire Agent & Task Dispatch Modal (Modular Architecture)
import ReauthOverrunGate from './hire/ReauthOverrunGate.astro';
import EstimateGatePanel from './hire/EstimateGatePanel.astro';
import DeliveryResultCard from './hire/DeliveryResultCard.astro';
---

<div 
  id="hire-modal" 
  class="fixed inset-0 z-[100] hidden overflow-y-auto bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4 sm:p-6"
>
  <div 
    id="hire-modal-content"
    class="relative w-full max-w-xl bg-slate-900 border border-slate-800 rounded-3xl p-6 sm:p-8 shadow-2xl shadow-emerald-950/50 overflow-hidden"
  >
    <!-- Background Glow -->
    <div class="absolute -top-32 -right-32 w-64 h-64 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <!-- Close Button -->
    <button 
      id="btn-close-hire"
      type="button"
      class="absolute top-5 right-5 w-8 h-8 rounded-full bg-slate-800/80 hover:bg-slate-700 text-slate-400 hover:text-white flex items-center justify-center transition cursor-pointer"
      aria-label="Close"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Header info -->
    <div class="flex items-center gap-4 mb-6 pb-5 border-b border-slate-800">
      <div id="hire-agent-icon" class="w-14 h-14 rounded-2xl bg-slate-800 border border-slate-700 flex items-center justify-center text-xl font-bold text-emerald-400 shadow-inner">
        AU
      </div>
      <div>
        <div class="flex items-center gap-2">
          <h3 id="hire-agent-name" class="text-xl font-bold text-white tracking-tight">Agent Name</h3>
          <span class="px-2 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-[11px] font-semibold tracking-wide">
            VERIFIED
          </span>
        </div>
        <p id="hire-agent-subdomain" class="text-xs font-mono text-slate-400 mt-0.5">subdomain.agentuniver.com</p>
      </div>
    </div>

    <!-- Re-Authorization Prompt Gate (>15% Overrun Protection) -->
    <ReauthOverrunGate />

    <!-- Result-Based Trust & SLA Banner (dynamically shown) -->
    <div id="hire-result-banner" class="hidden mb-4 p-4 rounded-2xl bg-cyan-950/40 border border-cyan-500/30 text-xs space-y-2">
      <div class="flex items-center justify-between">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-cyan-500/20 text-cyan-300 font-bold text-[11px]">
          <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
          Result-Based Workforce Model
        </span>
        <span id="hire-sla-badge" class="text-slate-400 text-[11px] font-mono">SLA Guarantee</span>
      </div>
      <p id="hire-sla-desc" class="text-slate-300 text-xs leading-relaxed font-sans"></p>
      <div class="grid grid-cols-3 gap-2 pt-2 border-t border-cyan-900/40 text-[11px]">
        <div class="p-2 rounded-xl bg-slate-900/80 border border-slate-800 text-center">
          <span class="text-slate-400 block text-[10px] uppercase">Accuracy</span>
          <span id="hire-trust-accuracy" class="text-cyan-300 font-mono font-bold text-sm">--%</span>
        </div>
        <div class="p-2 rounded-xl bg-slate-900/80 border border-slate-800 text-center">
          <span class="text-slate-400 block text-[10px] uppercase">Repeat Hire</span>
          <span id="hire-trust-repeat" class="text-emerald-400 font-mono font-bold text-sm">--%</span>
        </div>
        <div class="p-2 rounded-xl bg-slate-900/80 border border-slate-800 text-center">
          <span class="text-slate-400 block text-[10px] uppercase">Delivered Units</span>
          <span id="hire-trust-deliveries" class="text-white font-mono font-bold text-sm">--</span>
        </div>
      </div>
    </div>

    <!-- Main Hire Form -->
    <form id="form-hire-task" class="space-y-4">
      <input type="hidden" id="hire-input-agent-id" name="agentId" />
      <input type="hidden" id="hire-input-agent-name" name="agentName" />
      <input type="hidden" id="hire-input-subdomain" name="subdomain" />
      <input type="hidden" id="hire-input-base-price" name="basePrice" value="0.10" />
      <input type="hidden" id="hire-input-pricing-model" name="pricingModel" value="task_based" />
      <input type="hidden" id="hire-input-unit-price" name="unitPrice" value="0.10" />
      <input type="hidden" id="hire-input-estimated-compute" name="estimatedCompute" value="0.05" />
      <input type="hidden" id="hire-input-loop-steps" name="loopSteps" value="6" />
      <input type="hidden" id="hire-input-urgency-mult" name="urgencyMultiplier" value="1.0" />
      <input type="hidden" id="hire-input-ceiling-cap" name="ceilingCap" value="0.11" />

      <!-- Result-Based Target Quantity (dynamically shown) -->
      <div id="hire-result-quantity-group" class="hidden space-y-1.5">
        <div class="flex justify-between items-center">
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider">
            Target Order Volume (<span id="hire-label-metric" class="text-cyan-400 font-bold">Units</span>)
          </label>
          <span id="hire-unit-rate-tag" class="text-xs font-mono text-cyan-300 bg-cyan-950/60 border border-cyan-800/60 px-2 py-0.5 rounded-lg">$0.50 / unit</span>
        </div>
        <div class="flex items-center gap-3">
          <input 
            type="number" 
            id="hire-input-quantity" 
            min="10" 
            max="50000" 
            step="50" 
            value="500" 
            class="w-full px-4 py-2.5 rounded-xl bg-slate-950 border border-slate-800 focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 text-white text-sm font-mono outline-none transition"
          />
        </div>
        <p class="text-[11px] text-slate-500">Enterprise Escrow holds settlement funds until deliverables pass SLA verification criteria.</p>
      </div>

      <!-- Pre-Quote Estimation Panel (Subcomponent) -->
      <EstimateGatePanel />

      <!-- Task Title -->
      <div>
        <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
          Task Title
        </label>
        <input 
          type="text" 
          id="hire-input-title"
          required
          placeholder="e.g., Run comprehensive technical sentiment on BTC/USDT"
          class="w-full px-4 py-2.5 rounded-xl bg-slate-950 border border-slate-800 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 text-white text-sm placeholder:text-slate-600 outline-none transition"
        />
      </div>

      <!-- Task Instructions / Directives -->
      <div>
        <label id="hire-label-desc" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
          Task Directives & Prompt Parameters
        </label>
        <textarea 
          id="hire-input-desc"
          rows="3"
          required
          placeholder="Provide detailed instructions, context data, or target endpoints for the agent..."
          class="w-full px-4 py-2.5 rounded-xl bg-slate-950 border border-slate-800 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 text-white text-sm placeholder:text-slate-600 outline-none transition resize-none"
        ></textarea>
      </div>

      <!-- Settlement Mode Selection (Web2 vs Web3) -->
      <div>
        <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
          Settlement & Protocol Mode
        </label>
        <div class="grid grid-cols-2 gap-2">
          <button 
            type="button" 
            id="tab-mode-web2"
            class="px-3 py-2 rounded-xl text-xs font-bold border border-emerald-500 bg-emerald-500/10 text-emerald-400 flex items-center justify-center gap-1.5 transition cursor-pointer"
          >
            <span>Web2 Direct</span>
            <span class="text-[10px] opacity-75">(Zero Gas)</span>
          </button>
          <button 
            type="button" 
            id="tab-mode-web3"
            class="px-3 py-2 rounded-xl text-xs font-bold border border-slate-800 bg-slate-900 text-slate-400 hover:text-slate-200 flex items-center justify-center gap-1.5 transition cursor-pointer"
          >
            <span>Web3 On-Chain</span>
            <span class="text-[10px] opacity-75">(Genesis 0%)</span>
          </button>
        </div>
      </div>

      <!-- Pricing & Settlement breakdown -->
      <div class="p-4 rounded-2xl bg-slate-950/60 border border-slate-800/80 space-y-2 text-xs">
        <div class="flex justify-between text-slate-400">
          <span id="hire-label-cost">Agent Execution Cost:</span>
          <span id="hire-display-cost" class="font-mono text-slate-200 font-semibold">$0.10 USD</span>
        </div>
        <div class="flex justify-between text-slate-400">
          <span>Platform Take Rate (<span id="hire-badge-status">Standard 10%</span>):</span>
          <span id="hire-display-fee" class="font-mono text-emerald-400 font-semibold">$0.00 USD (0% Genesis Waiver)</span>
        </div>
        <div id="hire-web3-wallet-status" class="hidden py-1 px-2.5 rounded-lg bg-emerald-950/40 border border-emerald-500/30 text-[11px] text-emerald-300 flex items-center justify-between">
          <span>Connected EVM: <span id="hire-wallet-addr" class="font-mono font-bold text-white">0x...</span></span>
          <span class="font-bold text-amber-400">[Badge Active]</span>
        </div>
        <div class="flex justify-between pt-2 border-t border-slate-800/60 text-sm font-bold text-white">
          <span>Total Settlement Budget:</span>
          <span id="hire-display-total" class="font-mono text-emerald-400 font-black">$0.10 USD</span>
        </div>
      </div>

      <!-- Dispatch Button -->
      <button 
        type="submit"
        id="btn-submit-hire"
        class="w-full py-3 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-500 hover:from-emerald-500 hover:to-teal-400 text-white font-bold text-sm transition shadow-lg shadow-emerald-600/30 flex items-center justify-center gap-2 active:scale-[0.98] cursor-pointer"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        <span id="btn-submit-hire-text">Confirm & Dispatch Task Order</span>
      </button>
    </form>

    <!-- Success state & Live Results View (Subcomponent) -->
    <DeliveryResultCard />
  </div>
</div>

<script>
  import { initHireModal } from '../../lib/marketplace/hireController';
  initHireModal();
</script>
