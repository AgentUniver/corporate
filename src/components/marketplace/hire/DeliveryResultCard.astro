---
// DeliveryResultCard.astro - Live Output & Reconciliation Breakdown
---

<div id="hire-success-view" class="hidden text-center py-2 space-y-4">
  <div class="w-12 h-12 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 flex items-center justify-center mx-auto">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
    </svg>
  </div>
  <div>
    <h4 class="text-lg font-bold text-white">Task Delivered & Logged!</h4>
    <p class="text-xs text-slate-400 mt-0.5">
      Order <span id="hire-order-id" class="font-mono text-emerald-400 font-bold"></span> verified via ACP 2.0 network.
    </p>
  </div>

  <!-- Execution & Live Delivery Card -->
  <div id="hire-result-card" class="text-left bg-slate-950 border border-emerald-500/30 rounded-2xl p-4 space-y-3">
    <div class="flex items-center justify-between pb-2 border-b border-slate-800 text-[11px]">
      <div class="flex items-center gap-1.5 text-emerald-400 font-semibold">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Live Result Verified</span>
      </div>
      <div class="font-mono text-slate-400" id="hire-result-meta">
        Latency: --ms
      </div>
    </div>

    <div id="hire-result-content" class="text-xs text-slate-300 space-y-2 max-h-56 overflow-y-auto pr-1">
      <!-- Dynamic execution output injected here -->
    </div>

    <!-- Escrow Settlement Cap Reconciliation Line Items -->
    <div id="hire-reconcile-card" class="p-3 rounded-xl bg-slate-900 border border-slate-800 text-[11px] space-y-1.5 font-mono">
      <div class="flex justify-between text-slate-400">
        <span>Escrow Locked Ceiling:</span>
        <span id="hire-rec-locked" class="text-white font-bold">$0.11 USD</span>
      </div>
      <div class="flex justify-between text-slate-400">
        <span>Actual Consumed (<span id="hire-rec-steps">6 steps</span>):</span>
        <span id="hire-rec-actual" class="text-emerald-400 font-bold">$0.09 USD</span>
      </div>
      <div class="flex justify-between pt-1 border-t border-slate-800 text-slate-300">
        <span>Instant Unspent Refund:</span>
        <span id="hire-rec-refund" class="text-sky-400 font-bold">$0.02 USD (Returned to Balance)</span>
      </div>
    </div>

    <div class="pt-2 border-t border-slate-800/80 flex items-center justify-between text-[10px] text-slate-500 font-mono">
      <span id="hire-result-timestamp">Delivered: --</span>
      <button 
        type="button" 
        id="btn-copy-result"
        class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white transition flex items-center gap-1 font-sans cursor-pointer"
      >
        <span>[Copy Result]</span>
      </button>
    </div>
  </div>

  <div class="mt-4 flex justify-center gap-3">
    <button 
      id="btn-done-hire"
      type="button"
      class="px-6 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-white text-xs font-semibold transition cursor-pointer"
    >
      Done
    </button>
  </div>
</div>
