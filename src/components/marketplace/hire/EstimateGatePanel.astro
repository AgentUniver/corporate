---
// EstimateGatePanel.astro - Dynamic Quotation & Reasoning Loop Depth Estimation
---

<div id="hire-estimate-panel" class="p-4 rounded-2xl bg-slate-950/90 border border-emerald-500/30 space-y-3">
  <div class="flex items-center justify-between pb-2 border-b border-slate-800">
    <div class="flex items-center gap-2">
      <span class="px-2 py-0.5 rounded-md bg-emerald-500/10 text-emerald-400 font-mono text-[10px] font-bold">
        ESTIMATE-GATE
      </span>
      <h4 class="text-xs font-bold text-white uppercase tracking-wider">Dynamic Quotation & Ceiling Cap</h4>
    </div>
    <span class="text-[10px] font-mono text-slate-400">PRD 2.2 Spec</span>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
    <!-- Factor 2: Loop Complexity Depth -->
    <div>
      <label class="block text-[11px] font-semibold text-slate-400 uppercase mb-1">
        Loop Reasoning Depth
      </label>
      <select 
        id="hire-select-loop-depth" 
        class="w-full bg-slate-900 border border-slate-800 focus:border-emerald-500 rounded-xl px-3 py-2 text-xs text-slate-100 outline-none transition cursor-pointer"
      >
        <option value="single">Single-Shot (1-3 Steps, +$0.02)</option>
        <option value="react" selected>Iterative ReAct (4-10 Steps, +$0.06)</option>
        <option value="deep">Deep Long-Range (10+ Steps, +$0.15)</option>
      </select>
    </div>

    <!-- Factor 3: Urgency Multiplier -->
    <div>
      <label class="block text-[11px] font-semibold text-slate-400 uppercase mb-1">
        Urgency & Window
      </label>
      <select 
        id="hire-select-urgency" 
        class="w-full bg-slate-900 border border-slate-800 focus:border-emerald-500 rounded-xl px-3 py-2 text-xs text-slate-100 outline-none transition cursor-pointer"
      >
        <option value="offpeak">Off-Peak Batch (0.6x Discount)</option>
        <option value="standard" selected>Standard Window (1.0x Base)</option>
        <option value="rush">Rush Urgent (1.8x Priority)</option>
      </select>
    </div>
  </div>

  <!-- Realtime Estimate Summary -->
  <div class="pt-2 border-t border-slate-800/80 flex items-center justify-between text-xs">
    <div class="space-y-0.5">
      <span class="text-[11px] text-slate-400 block">Authorized Ceiling Cap (Max Lock):</span>
      <span class="text-[10px] text-slate-500">Unused funds refunded. Overruns &gt; 15% trigger re-auth.</span>
    </div>
    <div class="text-right">
      <span id="hire-est-ceiling-display" class="text-sm font-black font-mono text-emerald-400">$0.11 USD</span>
    </div>
  </div>
</div>
