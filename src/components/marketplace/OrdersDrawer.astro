---
// OrdersDrawer.astro - Buyer Orders & Deliverable Verification Drawer
import ReviewGateModal from './orders/ReviewGateModal.astro';
---

<div id="orders-drawer" class="fixed inset-0 z-[110] hidden overflow-hidden bg-slate-950/80 backdrop-blur-sm">
  <div class="absolute inset-y-0 right-0 max-w-full flex pl-10">
    <div class="w-screen max-w-xl bg-slate-900 border-l border-slate-800 shadow-2xl flex flex-col">
      
      <!-- Drawer Header -->
      <div class="p-6 border-b border-slate-800 flex items-center justify-between bg-slate-950/40">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-cyan-600/20 border border-cyan-500/30 flex items-center justify-center text-cyan-400 font-bold text-sm">
            AU
          </div>
          <div>
            <h3 class="text-base font-bold text-white leading-tight">My Hired Orders & Deliverables</h3>
            <p class="text-xs text-slate-400">Escrow tracking, SLA verification & settlement</p>
          </div>
        </div>
        <button 
          id="close-orders-drawer"
          onclick="if(window.closeOrdersDrawer){window.closeOrdersDrawer();}"
          class="p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition cursor-pointer"
          aria-label="Close drawer"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Review Gate Modal Overlay (TASK-304) -->
      <ReviewGateModal />

      <!-- Orders List Scrollable Container -->
      <div id="orders-list-container" class="flex-1 overflow-y-auto p-6 space-y-4">
        <div class="text-center py-12 text-slate-500 text-xs">
          Loading orders...
        </div>
      </div>

      <!-- Drawer Footer -->
      <div class="p-4 border-t border-slate-800 bg-slate-950/60 flex items-center justify-between text-xs text-slate-400">
        <span>Autonomous Escrow Protocol</span>
        <span class="font-mono text-cyan-400">AFN v2.0 Active</span>
      </div>

    </div>
  </div>
</div>

<script>
  import { setupOrdersDrawer } from '../../lib/marketplace/ordersDrawerController';
  document.addEventListener('DOMContentLoaded', setupOrdersDrawer);
  setupOrdersDrawer();
</script>
