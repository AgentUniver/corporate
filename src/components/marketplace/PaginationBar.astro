---
// Subcomponent: Pagination Controller & Empty State
---

<!-- DDS UI Compliant Pagination Controller -->
<div id="pagination-controls" class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-8 border-t border-slate-800/80 mt-8">
  <!-- Range & Count Indicator -->
  <div class="text-xs font-medium text-slate-400">
    Showing <span id="pagination-range" class="text-white font-semibold font-mono">1-6</span> of <span id="pagination-total" class="text-white font-semibold font-mono">20</span> Agents • Page <span id="pagination-current-page" class="text-emerald-400 font-semibold font-mono">1</span> of <span id="pagination-total-pages" class="text-slate-300 font-mono">4</span>
  </div>

  <!-- Page Navigator Buttons -->
  <div class="flex items-center gap-1.5 sm:gap-2">
    <button 
      id="btn-pagination-prev" 
      type="button" 
      class="px-3 py-1.5 rounded-xl bg-slate-900 border border-slate-800 text-xs font-semibold text-slate-300 hover:text-white hover:border-slate-700 disabled:opacity-40 disabled:cursor-not-allowed transition-all duration-300 ease-out active:scale-[0.98] focus-visible:ring-2 focus-visible:ring-emerald-500/30 flex items-center gap-1.5 cursor-pointer"
      disabled
    >
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      <span>Previous</span>
    </button>

    <!-- Dynamic Numbered Page Badges -->
    <div id="pagination-numbers" class="flex items-center gap-1"></div>

    <button 
      id="btn-pagination-next" 
      type="button" 
      class="px-3 py-1.5 rounded-xl bg-slate-900 border border-slate-800 text-xs font-semibold text-slate-300 hover:text-white hover:border-slate-700 disabled:opacity-40 disabled:cursor-not-allowed transition-all duration-300 ease-out active:scale-[0.98] focus-visible:ring-2 focus-visible:ring-emerald-500/30 flex items-center gap-1.5 cursor-pointer"
    >
      <span>Next</span>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </button>
  </div>
</div>

<!-- Empty State -->
<div id="empty-state" class="hidden text-center py-16 px-4 bg-slate-900/40 rounded-3xl border border-slate-800 mt-6">
  <div class="w-12 h-12 rounded-full bg-slate-800 text-slate-400 flex items-center justify-center mx-auto mb-3">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
  </div>
  <h3 class="text-base font-bold text-white">No Matching Agents Found</h3>
  <p class="text-xs text-slate-400 mt-1 max-w-sm mx-auto">
    Try adjusting your search terms or connect your own agent to publish it into this category.
  </p>
  <a 
    href="/create" 
    class="inline-block mt-4 px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold transition"
  >
    Connect Your Agent
  </a>
</div>
