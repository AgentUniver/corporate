---
// PageAlert.astro - Global Page-Level Toast / Notification Banner
---

<div 
  id="global-page-alert-container" 
  class="fixed top-5 left-1/2 -translate-x-1/2 z-[150] w-full max-w-lg px-4 pointer-events-none transition-all duration-300 opacity-0 -translate-y-4 hidden"
  role="alert"
  aria-live="assertive"
>
  <div 
    id="global-page-alert-card" 
    class="pointer-events-auto relative overflow-hidden rounded-2xl bg-slate-900/95 backdrop-blur-xl border border-slate-800 p-4 shadow-2xl shadow-black/80 transition-all duration-200"
  >
    <!-- Background subtle glow -->
    <div id="page-alert-glow" class="absolute -top-12 -left-12 w-28 h-28 bg-emerald-500/15 rounded-full blur-2xl pointer-events-none"></div>

    <div class="flex items-start gap-3.5 relative z-10">
      <!-- Status Icon -->
      <div id="page-alert-icon-box" class="flex-shrink-0 w-9 h-9 rounded-xl flex items-center justify-center bg-slate-800 text-emerald-400 border border-slate-700/80">
        <!-- Default Warning Icon -->
        <svg id="page-alert-icon-svg" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
      </div>

      <!-- Text Content -->
      <div class="flex-1 min-w-0 pt-0.5">
        <h4 id="page-alert-title" class="text-xs sm:text-sm font-bold text-white tracking-tight leading-snug">
          Notice
        </h4>
        <p id="page-alert-message" class="text-xs text-slate-300/90 leading-relaxed mt-1 break-words">
          Notification content
        </p>

        <!-- Optional Action Button -->
        <div id="page-alert-action-container" class="hidden mt-3 flex items-center gap-2">
          <a 
            id="page-alert-action-btn" 
            href="#" 
            target="_blank" 
            rel="noreferrer"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-emerald-600 hover:bg-emerald-500 text-white transition shadow-sm"
          >
            <span id="page-alert-action-label">Action</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Close Button -->
      <button 
        id="page-alert-close-btn" 
        type="button" 
        class="flex-shrink-0 w-7 h-7 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 flex items-center justify-center transition"
        aria-label="Close notification"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Countdown Progress Bar -->
    <div class="mt-3 h-0.5 w-full bg-slate-800 rounded-full overflow-hidden">
      <div id="page-alert-progress" class="h-full bg-emerald-400/80 transition-all ease-linear w-full"></div>
    </div>
  </div>
</div>

<script>
  interface PageAlertOptions {
    type?: 'warning' | 'info' | 'error' | 'success';
    title?: string;
    message: string;
    action?: {
      label: string;
      url?: string;
      onClick?: () => void;
    };
    duration?: number; // ms, default 5000
  }

  const container = document.getElementById('global-page-alert-container');
  const card = document.getElementById('global-page-alert-card');
  const glow = document.getElementById('page-alert-glow');
  const iconBox = document.getElementById('page-alert-icon-box');
  const titleEl = document.getElementById('page-alert-title');
  const messageEl = document.getElementById('page-alert-message');
  const actionContainer = document.getElementById('page-alert-action-container');
  const actionBtn = document.getElementById('page-alert-action-btn') as HTMLAnchorElement | null;
  const actionLabel = document.getElementById('page-alert-action-label');
  const closeBtn = document.getElementById('page-alert-close-btn');
  const progress = document.getElementById('page-alert-progress');

  let hideTimeout: any = null;
  let progressInterval: any = null;
  let totalDuration = 5000;

  const ICONS: Record<string, string> = {
    warning: `
      <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
    `,
    error: `
      <svg class="w-5 h-5 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    `,
    info: `
      <svg class="w-5 h-5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    `,
    success: `
      <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    `
  };

  const THEMES: Record<string, { border: string; glow: string; iconBg: string; bar: string }> = {
    warning: {
      border: 'border-amber-500/40',
      glow: 'bg-amber-500/20',
      iconBg: 'bg-amber-950/60 border-amber-500/40',
      bar: 'bg-amber-400'
    },
    error: {
      border: 'border-rose-500/40',
      glow: 'bg-rose-500/20',
      iconBg: 'bg-rose-950/60 border-rose-500/40',
      bar: 'bg-rose-400'
    },
    info: {
      border: 'border-cyan-500/40',
      glow: 'bg-cyan-500/20',
      iconBg: 'bg-cyan-950/60 border-cyan-500/40',
      bar: 'bg-cyan-400'
    },
    success: {
      border: 'border-emerald-500/40',
      glow: 'bg-emerald-500/20',
      iconBg: 'bg-emerald-950/60 border-emerald-500/40',
      bar: 'bg-emerald-400'
    }
  };

  function dismissAlert() {
    if (!container) return;
    clearTimeout(hideTimeout);
    clearInterval(progressInterval);
    container.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
    container.classList.add('opacity-0', '-translate-y-4', 'pointer-events-none');
    setTimeout(() => {
      container.classList.add('hidden');
    }, 300);
  }

  function showPageAlert(opts: PageAlertOptions) {
    if (!container || !card) return;

    const type = opts.type || 'info';
    const duration = opts.duration ?? 5000;
    totalDuration = duration;

    // Set Text
    if (titleEl) {
      titleEl.textContent = opts.title || (type === 'warning' ? 'Notice' : type === 'error' ? 'Error' : type === 'success' ? 'Success' : 'Information');
    }
    if (messageEl) {
      messageEl.textContent = opts.message;
    }

    // Set Icons & Theme
    if (iconBox) {
      iconBox.innerHTML = ICONS[type] || ICONS.info;
      const theme = THEMES[type] || THEMES.info;
      iconBox.className = `flex-shrink-0 w-9 h-9 rounded-xl flex items-center justify-center border ${theme.iconBg}`;
      if (card) {
        card.className = `pointer-events-auto relative overflow-hidden rounded-2xl bg-slate-900/95 backdrop-blur-xl border p-4 shadow-2xl shadow-black/80 transition-all duration-200 ${theme.border}`;
      }
      if (glow) {
        glow.className = `absolute -top-12 -left-12 w-28 h-28 rounded-full blur-2xl pointer-events-none ${theme.glow}`;
      }
      if (progress) {
        progress.className = `h-full transition-all ease-linear w-full ${theme.bar}`;
      }
    }

    // Handle Action Button
    if (actionContainer && actionBtn && actionLabel) {
      if (opts.action) {
        actionContainer.classList.remove('hidden');
        actionLabel.textContent = opts.action.label;
        if (opts.action.url) {
          actionBtn.href = opts.action.url;
          actionBtn.onclick = null;
        } else if (opts.action.onClick) {
          actionBtn.href = 'javascript:void(0);';
          actionBtn.onclick = () => {
            opts.action?.onClick?.();
            dismissAlert();
          };
        }
      } else {
        actionContainer.classList.add('hidden');
      }
    }

    // Show container: remove hidden first, then animate in
    clearTimeout(hideTimeout);
    clearInterval(progressInterval);
    container.classList.remove('hidden');
    requestAnimationFrame(() => {
      container.classList.remove('opacity-0', '-translate-y-4', 'pointer-events-none');
      container.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
    });

    // Progress bar animation
    if (progress) {
      progress.style.width = '100%';
    }

    const startTime = Date.now();
    progressInterval = setInterval(() => {
      const elapsed = Date.now() - startTime;
      const pct = Math.max(0, 100 - (elapsed / totalDuration) * 100);
      if (progress) {
        progress.style.width = `${pct}%`;
      }
      if (elapsed >= totalDuration) {
        clearInterval(progressInterval);
        dismissAlert();
      }
    }, 50);
  }

  closeBtn?.addEventListener('click', dismissAlert);

  // Global Attachment
  (window as any).showPageAlert = showPageAlert;
  (window as any).dismissPageAlert = dismissAlert;

  // Custom Event Dispatcher
  window.addEventListener('page_alert', ((e: CustomEvent<PageAlertOptions>) => {
    if (e.detail) {
      showPageAlert(e.detail);
    }
  }) as EventListener);

  // Intercept window.alert to automatically upgrade to PageAlert
  window.alert = function(msg?: any) {
    const text = String(msg ?? '');
    // Check if it's a wallet warning
    if (text.includes('Web3 wallet') || text.includes('MetaMask') || text.includes('OKX')) {
      showPageAlert({
        type: 'warning',
        title: 'Web3 Wallet Required',
        message: text,
        action: {
          label: 'Install MetaMask',
          url: 'https://metamask.io/download/'
        },
        duration: 7000
      });
      return;
    }

    showPageAlert({
      type: 'info',
      title: 'Notice',
      message: text,
      duration: 5000
    });
  };
</script>
