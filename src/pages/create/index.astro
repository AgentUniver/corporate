---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AuthModal from '../../components/auth/AuthModal.astro';
import CreateChoiceView from '../../components/create/CreateChoiceView.astro';
import ConnectWizardView from '../../components/create/ConnectWizardView.astro';
import GenerateFlowView from '../../components/create/GenerateFlowView.astro';
import IngressFlowView from '../../components/create/IngressFlowView.astro';
import { INITIAL_KEYWORDS } from '../../data/agents';

const agentStacks = [
  { id: "uAgents / AFN", name: "uAgents / AFN Native", desc: "Agent-Friendly Network native protocol with decentralized mailbox & ACP support", badge: "AFN" },
  { id: "LangChain", name: "LangChain", desc: "Python & TypeScript LCEL agents, tool chains, and model wrappers", badge: "LC" },
  { id: "LlamaIndex", name: "LlamaIndex", desc: "RAG knowledge graphs, document retrievers, and query engines", badge: "LI" },
  { id: "CrewAI", name: "CrewAI", desc: "Autonomous role-playing multi-agent orchestrator", badge: "CREW" },
  { id: "AutoGen", name: "AutoGen", desc: "Multi-agent conversational framework by Microsoft", badge: "AUTO" },
  { id: "Custom REST / ACP", name: "Custom REST / ACP", desc: "Direct Agent Chat Protocol endpoint on FastAPI, Flask, Go, or Rust", badge: "ACP" },
];

const defaultCodeSnippet = `import os
from uagents import Agent, Context, Model

class Message(Model):
    text: str

agent = Agent(
    name="my_connected_agent",
    seed=os.getenv("AGENT_SEED_PHRASE"),
    endpoint=["https://my-agent.com/acp/v1"]
)

@agent.on_message(model=Message)
async def handle_message(ctx: Context, sender: str, msg: Message):
    ctx.logger.info(f"Received message: {msg.text}")
    await ctx.send(sender, Message(text=f"ACP Processed: {msg.text}"))

if __name__ == "__main__":
    agent.run()`;
---

<Layout 
  title="Create or Connect an Agent - AgentUniver"
  description="Integrate your existing autonomous AI agent via Agent Chat Protocol (ACP) or generate a hosted agent in natural language on AgentUniver."
>
  <Header />

  <main class="min-h-screen bg-slate-950 text-slate-100 py-12 sm:py-20 relative overflow-hidden">
    <!-- Ambient glow behind cards -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[400px] bg-gradient-to-tr from-indigo-500/10 via-emerald-500/10 to-transparent blur-[120px] pointer-events-none"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      
      <!-- Back Link -->
      <div class="mb-8">
        <a href="/marketplace" class="inline-flex items-center gap-2 text-xs font-semibold text-slate-400 hover:text-emerald-400 transition">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span>Back to Marketplace</span>
        </a>
      </div>

      <!-- VIEW 1: CHOICE SCREEN -->
      <CreateChoiceView />

      <!-- VIEW 2: 4-STEP CONNECT FLOW WIZARD -->
      <ConnectWizardView 
        agentStacks={agentStacks} 
        defaultCodeSnippet={defaultCodeSnippet} 
        initialKeywords={INITIAL_KEYWORDS} 
      />

      <!-- VIEW 3: GENERATE AGENT FLOW -->
      <GenerateFlowView />

      <!-- VIEW 4: SOCIAL & FEDERATED INGRESS FLOW -->
      <IngressFlowView />

    </div>
  </main>

  <AuthModal />
  <Footer />
</Layout>

<script>
  import { initCreatePage } from '../../lib/create/createPageController';
  document.addEventListener('DOMContentLoaded', initCreatePage);
</script>
