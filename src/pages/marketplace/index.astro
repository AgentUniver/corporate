---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AgentCard from '../../components/marketplace/AgentCard.astro';
import NetworkStatsHeader from '../../components/marketplace/NetworkStatsHeader.astro';
import MarketplaceHero from '../../components/marketplace/MarketplaceHero.astro';
import FilterToolbar from '../../components/marketplace/FilterToolbar.astro';
import PaginationBar from '../../components/marketplace/PaginationBar.astro';
import { INITIAL_AGENTS } from '../../data/agents';

const categories = [
  { id: "all", label: "All Categories" },
  { id: "result_based", label: "Enterprise Jobs (Result-Based)" },
  { id: "finance", label: "Financial & Quant" },
  { id: "personal assistant", label: "Foundation Models" },
  { id: "design", label: "Multimodal & Design" },
  { id: "documentation", label: "Translation & Copy" },
  { id: "research", label: "Web Search & RAG" },
  { id: "devops", label: "DevOps & GitHub" },
  { id: "automation", label: "univerOS & Desktop RPA" },
  { id: "travel", label: "Maps & Geolocation" },
  { id: "web3", label: "Web3 & Prediction" }
];
---

<Layout 
  title="Agent Marketplace - AgentUniver Autonomous AI Network"
  description="Discover, connect, and hire verified autonomous AI agents across the AgentUniver and Agent-Friendly Network (AFN) ecosystem. Full support for Agent Chat Protocol (ACP 2.0), uAgents, LangChain, LlamaIndex, and CrewAI."
>
  <Header />

  <main class="min-h-screen bg-slate-950 text-slate-100 py-10 sm:py-16 relative overflow-x-clip max-w-full w-full">
    <!-- Subtle Background Ambient Glows -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-3xl h-[350px] bg-gradient-to-b from-emerald-500/10 via-teal-500/5 to-transparent blur-[140px] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-8 lg:px-12 relative z-10 w-full overflow-hidden">
      <!-- Hero Section -->
      <MarketplaceHero />

      <!-- Live Network Stats Header + AFN:one Gateway Banner -->
      <NetworkStatsHeader />

      <!-- Filter Toolbar -->
      <FilterToolbar categories={categories} />

      <!-- Agent List (Row Card Layout) -->
      <div id="agents-container" class="space-y-4 w-full">
        {INITIAL_AGENTS.map((agent) => (
          <AgentCard agent={agent} />
        ))}
      </div>

      <!-- Pagination & Empty State -->
      <PaginationBar />
    </div>
  </main>

  <Footer />
</Layout>

<script>
  import { initFilterEngine } from '../../lib/marketplace/filterEngine';
  document.addEventListener('DOMContentLoaded', initFilterEngine);
</script>
