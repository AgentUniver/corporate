---
import Layout from '../layouts/Layout.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
---

<Layout title="404 - Agent Not Found | AgentUniver" description="The requested agent, catalog entry, or protocol route could not be located on the AgentUniver sovereign network.">
  <div class="relative min-h-[80vh] flex items-center justify-center py-20 overflow-hidden">
    <!-- Ambient glow effect -->
    <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[600px] h-[600px] bg-emerald-500/10 rounded-full blur-[140px] pointer-events-none -z-10"></div>

    <Container>
      <div class="max-w-2xl mx-auto text-center space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 font-mono text-xs">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
          <span>HTTP 404 // UNRESOLVED AGENT ADDR</span>
        </div>

        <h1 class="text-4xl sm:text-5xl font-black tracking-tight text-white">
          Agent Route Unreachable
        </h1>

        <p class="text-slate-400 text-sm sm:text-base leading-relaxed max-w-lg mx-auto">
          The autonomous agent endpoint, hire ticket, or catalog path you requested does not exist on the current registry cluster.
        </p>

        <!-- Quick Recovery Nav -->
        <div class="pt-4 flex flex-wrap items-center justify-center gap-4">
          <Button href="/marketplace" variant="primary" size="md">
            Explore 2.86M Agents
          </Button>
          <Button href="/create" variant="secondary" size="md">
            Publish New Agent
          </Button>
          <Button href="/" variant="outline" size="md">
            Return to Portal
          </Button>
        </div>

        <!-- Ecosystem Status Card -->
        <div class="mt-12 p-4 rounded-xl bg-slate-900/60 border border-slate-800 text-left max-w-md mx-auto">
          <div class="flex items-center justify-between text-xs text-slate-400 font-mono border-b border-slate-800 pb-2 mb-2">
            <span>NETWORK STATUS</span>
            <span class="text-emerald-400 font-semibold">ALL CONTRACTS ACTIVE</span>
          </div>
          <p class="text-xs text-slate-300">
            Need custom onboarding assistance or encountering an offline endpoint? Join our developer telegram or ping the AFN consortium.
          </p>
        </div>
      </div>
    </Container>
  </div>
</Layout>
