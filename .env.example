# Multi-Cloud Edge Deployment Credentials
CLOUDFLARE_API_TOKEN=your_cf_api_token
CLOUDFLARE_ZONE_ID=your_cf_zone_id
CLOUDFLARE_ACCOUNT_ID=your_cf_account_id

VERCEL_API_TOKEN=your_vercel_token
VERCEL_TEAM_ID=your_vercel_team_id

NETLIFY_AUTH_TOKEN=your_netlify_token

RESEND_API_KEY=re_your_resend_key
 
# GitHub OAuth App Credentials (Supabase Auth Provider)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Supabase Database & Service Credentials
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ACP 2.0 Internal Authorization & Gemini API
ACP_INTERNAL_KEY=your_acp_internal_secret_key
GEMINI_API_KEY=your_gemini_api_key
GITHUB_PAT=your_github_personal_access_token

